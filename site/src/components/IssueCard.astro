---
import CategoryBadge from "./CategoryBadge.astro";
import { truncateTitle } from "../lib/utils";
import type { IssueWithCategory } from "../lib/data";

interface Props {
  issue: IssueWithCategory;
}

const { issue } = Astro.props;
---

<a
  href={issue.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group block rounded-lg border border-border bg-surface-card p-4 transition-all hover:border-accent/50 hover:bg-surface-elevated"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <div class="mb-2 flex items-center gap-2">
        <CategoryBadge category={issue.category} />
        <span class="text-[10px] text-zinc-500 font-semibold">+{issue.points} pt{issue.points !== 1 ? "s" : ""}</span>
      </div>
      <h3 class="text-sm font-medium text-white group-hover:text-accent transition-colors leading-snug">
        {truncateTitle(issue.title)}
      </h3>
      <div class="mt-2 text-xs text-zinc-500">
        {issue.owner}/{issue.repo}
      </div>
    </div>
    <svg class="mt-1 w-4 h-4 flex-shrink-0 text-zinc-500 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  </div>
</a>
