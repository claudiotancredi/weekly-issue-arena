---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-500">
    <span>&copy; {year} Weekly Issue Arena</span>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/claudiotancredi/weekly-issue-arena"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-zinc-400 transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://github.com/claudiotancredi/weekly-issue-arena/blob/main/LICENSE"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-zinc-400 transition-colors"
      >
        MIT License
      </a>
      <span>Built with Astro</span>
    </div>
  </div>
</footer>
