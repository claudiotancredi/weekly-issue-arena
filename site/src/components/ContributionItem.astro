---
import { formatDate } from "../lib/utils";
import type { Contribution } from "../lib/data";

interface Props {
  contribution: Contribution;
}

const { contribution } = Astro.props;

const pointColors: Record<number, string> = {
  1: "text-gfi",
  2: "text-bug",
  4: "text-hard",
};
---

<div class="flex items-start gap-3 rounded-lg border border-border bg-surface-card p-4">
  <div class={`text-lg font-bold min-w-[3rem] text-right ${pointColors[contribution.points] ?? "text-points"}`}>
    +{contribution.points}
  </div>
  <div class="flex-1 min-w-0">
    <a
      href={contribution.pr_url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-white hover:text-accent transition-colors"
    >
      {contribution.issue}
    </a>
    <div class="mt-1 flex items-center gap-3 text-xs text-zinc-500">
      <span>Week {contribution.week}</span>
      <span>{formatDate(contribution.credited_at)}</span>
      <a
        href={contribution.pr_url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent transition-colors"
      >
        View PR &rarr;
      </a>
    </div>
  </div>
</div>
