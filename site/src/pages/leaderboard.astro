---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeaderboardRow from "../components/LeaderboardRow.astro";
import { getLeaderboard } from "../lib/data";

const leaderboard = getLeaderboard();
---

<BaseLayout title="Leaderboard | Weekly Issue Arena" description="See who's leading the Weekly Issue Arena. Rankings updated hourly.">
  <div class="mx-auto max-w-4xl px-4 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Leaderboard</h1>
      <p class="mt-2 text-sm text-zinc-400">
        {leaderboard.length} contributor{leaderboard.length !== 1 ? "s" : ""}.
        Updated hourly. Ties broken alphabetically.
      </p>
    </div>

    {leaderboard.length > 0 ? (
      <div class="flex flex-col gap-2">
        {leaderboard.map((player) => (
          <LeaderboardRow player={player} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 text-zinc-500">
        <p class="text-lg">No contributors yet.</p>
        <p class="mt-2 text-sm">Be the first to close an Arena issue and earn points!</p>
      </div>
    )}
  </div>
</BaseLayout>
